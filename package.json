{
  "name": "unihub",
  "private": true,
  "version": "0.1.0",
  "description": "Naajah — university services, projects and academic tools platform",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "node scripts/dev-all.mjs",
    "db:start": "node scripts/db.mjs start",
    "db:stop": "node scripts/db.mjs stop",
    "db:migrate": "npm -w apps/api run prisma:migrate",
    "db:seed": "npm -w apps/api run prisma:seed",
    "dev:api": "npm -w apps/api run start:dev",
    "dev:web": "npm -w apps/web run dev",
    "build": "npm -w packages/shared run build && npm -w apps/api run build && npm -w apps/web run build",
    "lint": "npm -ws --if-present run lint",
    "typecheck": "npm -ws --if-present run typecheck",
    "test": "npm -ws --if-present run test"
  },
  "devDependencies": {
    "@playwright/test": "^1.51.1",
    "embedded-postgres": "17.10.0-beta.17"
  }
}
