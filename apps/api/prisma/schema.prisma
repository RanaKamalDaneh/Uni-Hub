// Naajah — PostgreSQL schema (Prisma)
// Conventions: cuid ids, createdAt/updatedAt on mutable entities, money stored as Decimal(12,2),
// bilingual text stored as paired columns (xxxEn / xxxAr) for catalog content.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ───────────────────────────── Enums ─────────────────────────────

enum UserStatus {
  ACTIVE
  SUSPENDED
  DEACTIVATED
}

enum Locale {
  en
  ar
}

enum ProviderVerificationStatus {
  UNSUBMITTED
  PENDING
  VERIFIED
  REJECTED
}

enum ServiceStatus {
  DRAFT
  PENDING_REVIEW
  PUBLISHED
  PAUSED
  REJECTED
  ARCHIVED
}

enum PackageTier {
  BASIC
  STANDARD
  PREMIUM
}

enum RequestStatus {
  DRAFT
  SUBMITTED
  UNDER_REVIEW
  AWAITING_PROPOSALS
  PROPOSAL_RECEIVED
  AWARDED
  CANCELLED
  EXPIRED
}

enum ProposalStatus {
  SUBMITTED
  SHORTLISTED
  ACCEPTED
  REJECTED
  WITHDRAWN
}

enum OrderStatus {
  AWAITING_APPROVAL
  APPROVED
  IN_PROGRESS
  DELIVERED
  REVISION_REQUESTED
  COMPLETED
  CANCELLED
  DISPUTED
}

enum OrderSource {
  SERVICE
  PROPOSAL
}

enum MilestoneStatus {
  PENDING
  IN_PROGRESS
  SUBMITTED
  APPROVED
}

enum PaymentStatus {
  PENDING
  REQUIRES_ACTION
  SUCCEEDED
  FAILED
  CANCELLED
  REFUNDED
  PARTIALLY_REFUNDED
}

enum TransactionType {
  CHARGE
  REFUND
  PROVIDER_PAYOUT
  COMMISSION
}

enum RefundStatus {
  REQUESTED
  APPROVED
  REJECTED
  PROCESSED
}

enum CouponType {
  PERCENT
  FIXED
}

enum NotificationType {
  PROPOSAL_RECEIVED
  PROPOSAL_ACCEPTED
  ORDER_STATUS
  MESSAGE
  PAYMENT
  DEADLINE
  REVIEW
  VERIFICATION
  SUPPORT
  SYSTEM
}

enum TicketStatus {
  OPEN
  IN_PROGRESS
  WAITING_ON_USER
  RESOLVED
  CLOSED
}

enum TicketPriority {
  LOW
  NORMAL
  HIGH
  URGENT
}

enum AttachmentScope {
  AVATAR
  REQUEST
  ORDER
  DELIVERABLE
  MESSAGE
  PORTFOLIO
  VERIFICATION
  ACADEMIC_DOCUMENT
  RESOURCE
  SUPPORT
}

enum AnalysisType {
  AI_INDICATORS
  SIMILARITY
  CITATIONS
  QUALITY
}

enum AnalysisStatus {
  QUEUED
  PROCESSING
  COMPLETED
  FAILED
}

enum CitationStyle {
  APA
  IEEE
  HARVARD
  MLA
  CHICAGO
}

enum Difficulty {
  BEGINNER
  INTERMEDIATE
  ADVANCED
}

// ───────────────────────── Identity & Access ─────────────────────────

model User {
  id            String     @id @default(cuid())
  email         String     @unique
  passwordHash  String
  fullName      String
  status        UserStatus @default(ACTIVE)
  emailVerified Boolean    @default(false)
  lastLoginAt   DateTime?
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt

  roles            UserRole[]
  profile          UserProfile?
  providerProfile  ProviderProfile?
  refreshTokens    RefreshToken[]
  requests         ProjectRequest[]
  studentOrders    Order[]             @relation("StudentOrders")
  providerOrders   Order[]             @relation("ProviderOrders")
  participations   ConversationParticipant[]
  messages         Message[]
  attachments      Attachment[]
  payments         Payment[]
  reviewsWritten   Review[]            @relation("ReviewAuthor")
  reviewsReceived  Review[]            @relation("ReviewProvider")
  favorites        Favorite[]
  notifications    Notification[]
  tickets          SupportTicket[]     @relation("TicketOwner")
  assignedTickets  SupportTicket[]     @relation("TicketAssignee")
  ticketMessages   SupportTicketMessage[]
  documents        AcademicDocument[]
  resources        Resource[]
  bookmarks        ResourceBookmark[]
  auditLogs        AuditLog[]
  refundsRequested Refund[]            @relation("RefundRequester")
  statusChanges    OrderStatusHistory[]

  @@index([status])
  @@index([createdAt])
}

model Role {
  id          String   @id @default(cuid())
  key         String   @unique // STUDENT, PROVIDER, ADMIN, SUPER_ADMIN, SUPPORT, FINANCE, MODERATOR
  name        String
  description String?
  isSystem    Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  users       UserRole[]
  permissions RolePermission[]
}

model Permission {
  id          String  @id @default(cuid())
  key         String  @unique // e.g. "orders.read.any"
  group       String
  description String?

  roles RolePermission[]
}

model UserRole {
  userId    String
  roleId    String
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  role Role @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([userId, roleId])
  @@index([roleId])
}

model RolePermission {
  roleId       String
  permissionId String

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@index([permissionId])
}

model RefreshToken {
  id         String    @id @default(cuid())
  userId     String
  family     String // rotation family; reuse of a revoked token revokes the whole family
  tokenHash  String    @unique
  expiresAt  DateTime
  revokedAt  DateTime?
  replacedBy String?
  userAgent  String?
  ip         String?
  createdAt  DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([family])
}

// ───────────────────────── Academic reference data ─────────────────────────

model University {
  id        String   @id @default(cuid())
  nameEn    String
  nameAr    String
  country   String   @default("JO")
  city      String?
  createdAt DateTime @default(now())

  faculties Faculty[]
  profiles  UserProfile[]

  @@unique([nameEn, country])
}

model Faculty {
  id           String @id @default(cuid())
  universityId String
  nameEn       String
  nameAr       String

  university  University    @relation(fields: [universityId], references: [id], onDelete: Cascade)
  departments Department[]
  profiles    UserProfile[]

  @@unique([universityId, nameEn])
}

model Department {
  id        String @id @default(cuid())
  facultyId String
  nameEn    String
  nameAr    String

  faculty  Faculty       @relation(fields: [facultyId], references: [id], onDelete: Cascade)
  profiles UserProfile[]

  @@unique([facultyId, nameEn])
}

model AcademicLevel {
  id        String @id @default(cuid())
  key       String @unique // BACHELOR, MASTER, PHD, DIPLOMA
  nameEn    String
  nameAr    String
  sortOrder Int    @default(0)

  profiles  UserProfile[]
  requests  ProjectRequest[]
  resources Resource[]
}

model UserProfile {
  id              String    @id @default(cuid())
  userId          String    @unique
  avatarKey       String?
  phone           String?
  universityId    String?
  facultyId       String?
  departmentId    String?
  major           String?
  academicLevelId String?
  graduationYear  Int?
  country         String?   @default("JO")
  preferredLocale Locale    @default(en)
  emailNotifications Boolean @default(true)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  user          User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  university    University?    @relation(fields: [universityId], references: [id], onDelete: SetNull)
  faculty       Faculty?       @relation(fields: [facultyId], references: [id], onDelete: SetNull)
  department    Department?    @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  academicLevel AcademicLevel? @relation(fields: [academicLevelId], references: [id], onDelete: SetNull)
}

// ───────────────────────── Providers ─────────────────────────

model ProviderProfile {
  id                 String                     @id @default(cuid())
  userId             String                     @unique
  slug               String                     @unique
  title              String
  bio                String
  titleAr            String? // optional Arabic versions shown to Arabic-language visitors
  bioAr              String?
  displayNameAr      String? // e.g. for organisation accounts; individuals use their own name
  yearsExperience    Int                        @default(0)
  qualifications     String?
  languages          String[]
  isAvailable        Boolean                    @default(true)
  availabilityNote   String?
  verificationStatus ProviderVerificationStatus @default(UNSUBMITTED)
  verificationNote   String?
  verifiedAt         DateTime?
  verifiedById       String?
  ratingAvg          Decimal                    @default(0) @db.Decimal(3, 2)
  ratingCount        Int                        @default(0)
  completedOrders    Int                        @default(0)
  createdAt          DateTime                   @default(now())
  updatedAt          DateTime                   @updatedAt

  user      User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  skills    ProviderSkill[]
  portfolio Portfolio[]
  services  Service[]
  proposals ProjectProposal[]

  @@index([verificationStatus])
  @@index([ratingAvg])
}

model ProviderSkill {
  id         String @id @default(cuid())
  providerId String
  name       String
  level      Int    @default(3) // 1..5

  provider ProviderProfile @relation(fields: [providerId], references: [id], onDelete: Cascade)

  @@unique([providerId, name])
  @@index([name])
}

model Portfolio {
  id           String   @id @default(cuid())
  providerId   String
  title        String
  description  String
  url          String?
  imageKey     String?
  technologies String[]
  categoryId   String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  provider ProviderProfile @relation(fields: [providerId], references: [id], onDelete: Cascade)
  category Category?       @relation(fields: [categoryId], references: [id], onDelete: SetNull)

  @@index([providerId])
}

// ───────────────────────── Catalog ─────────────────────────

model Category {
  id            String   @id @default(cuid())
  slug          String   @unique
  nameEn        String
  nameAr        String
  descriptionEn String
  descriptionAr String
  icon          String // lucide icon name
  color         String // design token key: blue | violet | teal | indigo | purple | royal | orange | cyan | green
  sortOrder     Int      @default(0)
  isActive      Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  subcategories Subcategory[]
  services      Service[]
  requests      ProjectRequest[]
  portfolio     Portfolio[]
}

model Subcategory {
  id         String   @id @default(cuid())
  categoryId String
  slug       String
  nameEn     String
  nameAr     String
  sortOrder  Int      @default(0)
  isActive   Boolean  @default(true)
  createdAt  DateTime @default(now())

  category Category  @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  services Service[]

  @@unique([categoryId, slug])
}

model Service {
  id                String        @id @default(cuid())
  slug              String        @unique
  providerId        String
  categoryId        String
  subcategoryId     String?
  titleEn           String
  titleAr           String
  summaryEn         String
  summaryAr         String
  overviewEn        String
  overviewAr        String
  includedEn        String[]
  includedAr        String[]
  featuresEn        String[]
  featuresAr        String[]
  requirementsEn    String[] // information required from the student
  requirementsAr    String[]
  deliverablesEn    String[]
  deliverablesAr    String[]
  technologies      String[]
  faq               Json          @default("[]") // [{qEn,qAr,aEn,aAr}]
  startingPrice     Decimal?      @db.Decimal(12, 2)
  currency          String        @default("JOD")
  deliveryDays      Int
  status            ServiceStatus @default(DRAFT)
  isFeatured        Boolean       @default(false)
  viewCount         Int           @default(0)
  ratingAvg         Decimal       @default(0) @db.Decimal(3, 2)
  ratingCount       Int           @default(0)
  rejectionReason   String?
  publishedAt       DateTime?
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt

  provider    ProviderProfile  @relation(fields: [providerId], references: [id], onDelete: Cascade)
  category    Category         @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  subcategory Subcategory?     @relation(fields: [subcategoryId], references: [id], onDelete: SetNull)
  packages    ServicePackage[]
  orders      Order[]
  reviews     Review[]
  favorites   Favorite[]

  @@index([categoryId, status])
  @@index([subcategoryId])
  @@index([providerId])
  @@index([status, isFeatured])
}

model ServicePackage {
  id            String      @id @default(cuid())
  serviceId     String
  tier          PackageTier
  nameEn        String
  nameAr        String
  descriptionEn String
  descriptionAr String
  price         Decimal     @db.Decimal(12, 2)
  deliveryDays  Int
  revisions     Int         @default(1)
  featuresEn    String[]
  featuresAr    String[]
  isActive      Boolean     @default(true)

  service Service @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  orders  Order[]

  @@unique([serviceId, tier])
}

// ───────────────────────── Requests & Proposals ─────────────────────────

model ProjectRequest {
  id                   String        @id @default(cuid())
  slug                 String        @unique
  studentId            String
  categoryId           String
  academicLevelId      String?
  title                String
  description          String
  university           String?
  major                String?
  courseName           String?
  technologies         String[]
  requiredFeatures     String[]
  expectedDeliverables String[]
  budgetMin            Decimal?      @db.Decimal(12, 2)
  budgetMax            Decimal?      @db.Decimal(12, 2)
  currency             String        @default("JOD")
  deadline             DateTime?
  instructions         String?
  isPublic             Boolean       @default(true) // visible in /projects listing (no private details)
  status               RequestStatus @default(DRAFT)
  moderationNote       String?
  createdAt            DateTime      @default(now())
  updatedAt            DateTime      @updatedAt

  student       User              @relation(fields: [studentId], references: [id], onDelete: Cascade)
  category      Category          @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  academicLevel AcademicLevel?    @relation(fields: [academicLevelId], references: [id], onDelete: SetNull)
  proposals     ProjectProposal[]
  attachments   Attachment[]
  order         Order?

  @@index([studentId])
  @@index([status, categoryId])
}

model ProjectProposal {
  id             String         @id @default(cuid())
  requestId      String
  providerId     String
  price          Decimal        @db.Decimal(12, 2)
  currency       String         @default("JOD")
  estimatedDays  Int
  workPlan       String
  deliverables   String[]
  experience     String?
  portfolioLinks String[]
  notes          String?
  status         ProposalStatus @default(SUBMITTED)
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  request  ProjectRequest  @relation(fields: [requestId], references: [id], onDelete: Cascade)
  provider ProviderProfile @relation(fields: [providerId], references: [id], onDelete: Cascade)
  order    Order?

  @@unique([requestId, providerId]) // one proposal per provider per request
  @@index([providerId])
}

// ───────────────────────── Orders ─────────────────────────

model Order {
  id               String      @id @default(cuid())
  number           String      @unique // human-friendly e.g. UH-2026-000123
  source           OrderSource
  studentId        String
  providerUserId   String
  serviceId        String?
  packageId        String?
  requestId        String?     @unique
  proposalId       String?     @unique
  couponId         String?
  title            String
  requirements     String?
  status           OrderStatus
  subtotal         Decimal     @db.Decimal(12, 2)
  discount         Decimal     @default(0) @db.Decimal(12, 2)
  total            Decimal     @db.Decimal(12, 2)
  currency         String      @default("JOD")
  commissionRate   Decimal     @db.Decimal(5, 4) // snapshot at creation, e.g. 0.1500
  revisionsAllowed Int         @default(1)
  revisionsUsed    Int         @default(0)
  deadline         DateTime?
  startedAt        DateTime?
  deliveredAt      DateTime?
  completedAt      DateTime?
  cancelledAt      DateTime?
  cancelReason     String?
  createdAt        DateTime    @default(now())
  updatedAt        DateTime    @updatedAt

  student       User                 @relation("StudentOrders", fields: [studentId], references: [id], onDelete: Restrict)
  provider      User                 @relation("ProviderOrders", fields: [providerUserId], references: [id], onDelete: Restrict)
  service       Service?             @relation(fields: [serviceId], references: [id], onDelete: SetNull)
  package       ServicePackage?      @relation(fields: [packageId], references: [id], onDelete: SetNull)
  request       ProjectRequest?      @relation(fields: [requestId], references: [id], onDelete: SetNull)
  proposal      ProjectProposal?     @relation(fields: [proposalId], references: [id], onDelete: SetNull)
  coupon        Coupon?              @relation(fields: [couponId], references: [id], onDelete: SetNull)
  milestones    OrderMilestone[]
  deliverables  OrderDeliverable[]
  statusHistory OrderStatusHistory[]
  notes         OrderNote[]
  attachments   Attachment[]
  conversation  Conversation?
  payments      Payment[]
  commission    Commission?
  refunds       Refund[]
  review        Review?

  @@index([studentId, status])
  @@index([providerUserId, status])
  @@index([status, createdAt])
  @@index([deadline])
}

model OrderMilestone {
  id          String          @id @default(cuid())
  orderId     String
  title       String
  description String?
  dueDate     DateTime?
  sortOrder   Int             @default(0)
  status      MilestoneStatus @default(PENDING)
  completedAt DateTime?
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  order        Order              @relation(fields: [orderId], references: [id], onDelete: Cascade)
  deliverables OrderDeliverable[]

  @@index([orderId])
}

model OrderDeliverable {
  id           String   @id @default(cuid())
  orderId      String
  milestoneId  String?
  title        String
  note         String?
  version      Int      @default(1)
  isFinal      Boolean  @default(false)
  uploadedById String
  createdAt    DateTime @default(now())

  order       Order           @relation(fields: [orderId], references: [id], onDelete: Cascade)
  milestone   OrderMilestone? @relation(fields: [milestoneId], references: [id], onDelete: SetNull)
  attachments Attachment[]

  @@index([orderId, title, version])
}

model OrderStatusHistory {
  id         String       @id @default(cuid())
  orderId    String
  fromStatus OrderStatus?
  toStatus   OrderStatus
  actorId    String?
  note       String?
  createdAt  DateTime     @default(now())

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)
  actor User? @relation(fields: [actorId], references: [id], onDelete: SetNull)

  @@index([orderId, createdAt])
}

model OrderNote {
  id        String   @id @default(cuid())
  orderId   String
  authorId  String
  body      String
  isPrivate Boolean  @default(true) // private to the author
  createdAt DateTime @default(now())

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId])
}

// ───────────────────────── Messaging ─────────────────────────

model Conversation {
  id            String   @id @default(cuid())
  orderId       String?  @unique
  subject       String?
  lastMessageAt DateTime @default(now())
  createdAt     DateTime @default(now())

  order        Order?                    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  participants ConversationParticipant[]
  messages     Message[]

  @@index([lastMessageAt])
}

model ConversationParticipant {
  conversationId String
  userId         String
  lastReadAt     DateTime?
  joinedAt       DateTime  @default(now())

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([conversationId, userId])
  @@index([userId])
}

model Message {
  id             String   @id @default(cuid())
  conversationId String
  senderId       String
  body           String
  createdAt      DateTime @default(now())
  editedAt       DateTime?

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  sender       User         @relation(fields: [senderId], references: [id], onDelete: Cascade)
  attachments  Attachment[]

  @@index([conversationId, createdAt])
}

// ───────────────────────── Files ─────────────────────────

model Attachment {
  id            String          @id @default(cuid())
  ownerId       String
  scope         AttachmentScope
  storageKey    String          @unique
  originalName  String
  mimeType      String
  sizeBytes     Int
  checksum      String // sha256
  requestId     String?
  orderId       String?
  deliverableId String?
  messageId     String?
  ticketMessageId String?
  createdAt     DateTime        @default(now())

  owner         User                  @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  request       ProjectRequest?       @relation(fields: [requestId], references: [id], onDelete: Cascade)
  order         Order?                @relation(fields: [orderId], references: [id], onDelete: Cascade)
  deliverable   OrderDeliverable?     @relation(fields: [deliverableId], references: [id], onDelete: Cascade)
  message       Message?              @relation(fields: [messageId], references: [id], onDelete: Cascade)
  ticketMessage SupportTicketMessage? @relation(fields: [ticketMessageId], references: [id], onDelete: Cascade)

  @@index([ownerId, scope])
  @@index([orderId])
  @@index([requestId])
}

// ───────────────────────── Payments ─────────────────────────

model Payment {
  id               String        @id @default(cuid())
  orderId          String
  payerId          String
  gateway          String // "sandbox" | "stripe" | ...
  gatewayRef       String?       @unique // gateway payment/intent id
  amount           Decimal       @db.Decimal(12, 2)
  currency         String        @default("JOD")
  status           PaymentStatus @default(PENDING)
  failureReason    String?
  confirmedAt      DateTime?
  invoiceNumber    String?       @unique
  metadata         Json?
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt

  order        Order         @relation(fields: [orderId], references: [id], onDelete: Restrict)
  payer        User          @relation(fields: [payerId], references: [id], onDelete: Restrict)
  transactions Transaction[]
  refunds      Refund[]

  @@index([orderId])
  @@index([payerId, createdAt])
  @@index([status])
}

model Transaction {
  id         String          @id @default(cuid())
  paymentId  String?
  type       TransactionType
  amount     Decimal         @db.Decimal(12, 2)
  currency   String          @default("JOD")
  userId     String? // counterparty (provider for payouts)
  reference  String?
  createdAt  DateTime        @default(now())

  payment Payment? @relation(fields: [paymentId], references: [id], onDelete: SetNull)

  @@index([type, createdAt])
  @@index([userId])
}

model Commission {
  id              String   @id @default(cuid())
  orderId         String   @unique
  rate            Decimal  @db.Decimal(5, 4)
  grossAmount     Decimal  @db.Decimal(12, 2)
  commissionAmount Decimal @db.Decimal(12, 2)
  providerAmount  Decimal  @db.Decimal(12, 2)
  currency        String   @default("JOD")
  settledAt       DateTime?
  createdAt       DateTime @default(now())

  order Order @relation(fields: [orderId], references: [id], onDelete: Restrict)

  @@index([createdAt])
}

model Refund {
  id            String       @id @default(cuid())
  orderId       String
  paymentId     String
  requestedById String
  amount        Decimal      @db.Decimal(12, 2)
  reason        String
  status        RefundStatus @default(REQUESTED)
  adminNote     String?
  processedAt   DateTime?
  gatewayRef    String?
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  order       Order   @relation(fields: [orderId], references: [id], onDelete: Restrict)
  payment     Payment @relation(fields: [paymentId], references: [id], onDelete: Restrict)
  requestedBy User    @relation("RefundRequester", fields: [requestedById], references: [id], onDelete: Restrict)

  @@index([status])
}

model Coupon {
  id            String     @id @default(cuid())
  code          String     @unique
  type          CouponType
  value         Decimal    @db.Decimal(12, 2)
  minOrderTotal Decimal?   @db.Decimal(12, 2)
  maxUses       Int?
  usedCount     Int        @default(0)
  startsAt      DateTime?
  expiresAt     DateTime?
  isActive      Boolean    @default(true)
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt

  orders Order[]
}

// ───────────────────────── Engagement ─────────────────────────

model Review {
  id         String   @id @default(cuid())
  orderId    String   @unique // one review per completed order
  serviceId  String?
  authorId   String
  providerId String // provider user id
  rating     Int // 1..5
  comment    String?
  reply      String?
  isHidden   Boolean  @default(false)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  order    Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  service  Service? @relation(fields: [serviceId], references: [id], onDelete: SetNull)
  author   User     @relation("ReviewAuthor", fields: [authorId], references: [id], onDelete: Cascade)
  provider User     @relation("ReviewProvider", fields: [providerId], references: [id], onDelete: Cascade)

  @@index([serviceId])
  @@index([providerId])
}

model Favorite {
  userId    String
  serviceId String
  createdAt DateTime @default(now())

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  service Service @relation(fields: [serviceId], references: [id], onDelete: Cascade)

  @@id([userId, serviceId])
}

model Notification {
  id        String           @id @default(cuid())
  userId    String
  type      NotificationType
  titleKey  String // i18n key, rendered client-side
  params    Json             @default("{}")
  link      String?
  readAt    DateTime?
  emailedAt DateTime?
  createdAt DateTime         @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, readAt])
  @@index([userId, createdAt])
}

model SupportTicket {
  id           String         @id @default(cuid())
  number       String         @unique
  userId       String
  assigneeId   String?
  subject      String
  category     String
  orderId      String?
  status       TicketStatus   @default(OPEN)
  priority     TicketPriority @default(NORMAL)
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt

  user     User                   @relation("TicketOwner", fields: [userId], references: [id], onDelete: Cascade)
  assignee User?                  @relation("TicketAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)
  messages SupportTicketMessage[]

  @@index([userId])
  @@index([status, priority])
}

model SupportTicketMessage {
  id         String   @id @default(cuid())
  ticketId   String
  authorId   String
  body       String
  isInternal Boolean  @default(false) // staff-only note
  createdAt  DateTime @default(now())

  ticket      SupportTicket @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  author      User          @relation(fields: [authorId], references: [id], onDelete: Cascade)
  attachments Attachment[]

  @@index([ticketId, createdAt])
}

// ───────────────────────── Academic tools ─────────────────────────

model AcademicDocument {
  id             String   @id @default(cuid())
  ownerId        String
  title          String
  originalName   String
  mimeType       String
  sizeBytes      Int
  storageKey     String   @unique
  checksum       String
  extractedText  String?
  wordCount      Int      @default(0)
  language       String?
  includeInCorpus Boolean @default(false) // owner consent to be compared against their own future uploads only
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  owner     User               @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  analyses  DocumentAnalysis[]
  citations Citation[]

  @@index([ownerId, createdAt])
}

model DocumentAnalysis {
  id          String         @id @default(cuid())
  documentId  String
  type        AnalysisType
  status      AnalysisStatus @default(QUEUED)
  engine      String // e.g. "local-stylometry-v1", "local-ngram-tfidf-v1"
  summary     Json? // engine-specific structured result
  score       Decimal?       @db.Decimal(5, 2)
  options     Json?
  error       String?
  startedAt   DateTime?
  completedAt DateTime?
  createdAt   DateTime       @default(now())

  document         AcademicDocument  @relation(fields: [documentId], references: [id], onDelete: Cascade)
  similarityReport SimilarityReport?

  @@index([documentId, type])
}

model SimilarityReport {
  id               String   @id @default(cuid())
  analysisId       String   @unique
  overallPercent   Decimal  @db.Decimal(5, 2)
  sourcesCompared  Int
  scope            String[] // ["own_documents","internal_resources","external:<provider>"]
  externalCoverage String // "none" unless a licensed external provider is configured
  createdAt        DateTime @default(now())

  analysis DocumentAnalysis  @relation(fields: [analysisId], references: [id], onDelete: Cascade)
  matches  SimilarityMatch[]
}

model SimilarityMatch {
  id           String  @id @default(cuid())
  reportId     String
  sourceType   String // "document" | "resource" | "external"
  sourceId     String?
  sourceTitle  String
  sourceUrl    String?
  matchedText  String
  sourceText   String
  startOffset  Int
  endOffset    Int
  similarity   Decimal @db.Decimal(5, 2)
  method       String // "exact_ngram" | "sentence_cosine"

  report SimilarityReport @relation(fields: [reportId], references: [id], onDelete: Cascade)

  @@index([reportId])
}

model Citation {
  id          String        @id @default(cuid())
  documentId  String
  style       CitationStyle
  raw         String
  isInText    Boolean       @default(false)
  isValid     Boolean
  issues      String[]
  matchedRefIndex Int?
  createdAt   DateTime      @default(now())

  document AcademicDocument @relation(fields: [documentId], references: [id], onDelete: Cascade)

  @@index([documentId])
}

// ───────────────────────── Resource library ─────────────────────────

model ResourceCategory {
  id        String  @id @default(cuid())
  slug      String  @unique
  nameEn    String
  nameAr    String
  icon      String
  sortOrder Int     @default(0)

  resources Resource[]
}

model Resource {
  id              String     @id @default(cuid())
  slug            String     @unique
  categoryId      String
  academicLevelId String?
  contributorId   String?
  titleEn         String
  titleAr         String
  descriptionEn   String
  descriptionAr   String
  technologies    String[]
  tags            String[]
  difficulty      Difficulty @default(BEGINNER)
  previewImages   String[]
  documentation   String? // markdown
  sourceUrl       String?
  license         String // SPDX id or "CC-BY-4.0" etc.
  licenseUrl      String?
  author          String // original author/attribution
  fileKey         String?
  fileName        String?
  requiresLogin   Boolean    @default(true)
  isPublished     Boolean    @default(false)
  downloadCount   Int        @default(0)
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt

  category      ResourceCategory   @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  academicLevel AcademicLevel?     @relation(fields: [academicLevelId], references: [id], onDelete: SetNull)
  contributor   User?              @relation(fields: [contributorId], references: [id], onDelete: SetNull)
  bookmarks     ResourceBookmark[]

  @@index([categoryId, isPublished])
  @@index([difficulty])
}

model ResourceBookmark {
  userId     String
  resourceId String
  createdAt  DateTime @default(now())

  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  resource Resource @relation(fields: [resourceId], references: [id], onDelete: Cascade)

  @@id([userId, resourceId])
}

// ───────────────────────── System ─────────────────────────

model AuditLog {
  id         String   @id @default(cuid())
  actorId    String?
  action     String // e.g. "provider.verify", "service.publish", "order.transition"
  entityType String
  entityId   String?
  before     Json?
  after      Json?
  ip         String?
  userAgent  String?
  createdAt  DateTime @default(now())

  actor User? @relation(fields: [actorId], references: [id], onDelete: SetNull)

  @@index([entityType, entityId])
  @@index([actorId, createdAt])
  @@index([createdAt])
}

model SystemSetting {
  key       String   @id // e.g. "commission.rate", "integrations.payment.gateway"
  value     Json
  updatedBy String?
  updatedAt DateTime @updatedAt
}
