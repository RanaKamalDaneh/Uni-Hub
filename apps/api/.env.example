# ── Core ──
NODE_ENV=development
PORT=4000
# Comma-separated list of allowed browser origins
CORS_ORIGINS=http://localhost:3000
WEB_URL=http://localhost:3000

# ── Database (embedded PostgreSQL from `npm run db:start`) ──
DATABASE_URL=postgresql://unihub:unihub_dev_password@localhost:54329/unihub?schema=public

# ── Auth (generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))") ──
JWT_ACCESS_SECRET=change-me-access-secret-at-least-32-chars-long
JWT_ACCESS_TTL=15m
REFRESH_TOKEN_TTL_DAYS=30

# Shared secret sent by the Next.js server (same value in apps/web/.env.local)
INTERNAL_API_KEY=

# ── Storage: "local" (dev) or "s3" ──
STORAGE_DRIVER=local
STORAGE_LOCAL_DIR=../../.data/uploads
S3_ENDPOINT=
S3_REGION=
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# ── Mail: "outbox" (dev: writes .eml files) or "smtp" ──
MAIL_DRIVER=outbox
MAIL_OUTBOX_DIR=../../.data/outbox
MAIL_FROM="UniHub <no-reply@unihub.local>"
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=

# ── Payments: "sandbox" (default) | "stripe" (adapter not configured until keys are set) ──
PAYMENT_GATEWAY=sandbox
PAYMENT_WEBHOOK_SECRET=change-me-webhook-secret
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# ── Academic tools: optional external integrations (left empty = "not configured") ──
AI_DETECTOR_PROVIDER=
AI_DETECTOR_API_URL=
AI_DETECTOR_API_KEY=
GRAMMAR_PROVIDER=
GRAMMAR_API_URL=
SIMILARITY_EXTERNAL_PROVIDER=
SIMILARITY_EXTERNAL_API_KEY=

# WhatsApp contact number (international format, digits only) applied when seeding a fresh database
SEED_WHATSAPP_NUMBER=
